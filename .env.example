# Copy to .env and adjust as needed
NODE_ENV=development

# Server
PORT=4000
DATABASE_URL=postgresql://devtunnel:devtunnel@localhost:5432/devtunnel
# Required — server will not start if Redis is unreachable
REDIS_URL=redis://localhost:6379

# Auth (generate real secrets before production)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Public tunnel domain (local MVP uses localhost)
TUNNEL_DOMAIN=devtunnel.app
PUBLIC_BASE_URL=http://localhost:4000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000
