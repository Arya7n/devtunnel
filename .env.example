# Copy to .env and adjust as needed
NODE_ENV=development

# Server
PORT=5000
DATABASE_URL=postgresql://devtunnel:devtunnel@localhost:5432/devtunnel
REDIS_URL=redis://localhost:6379

# Auth (generate real secrets before production)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Public tunnel domain
TUNNEL_DOMAIN=devtunnel.app
PUBLIC_BASE_URL=https://devtunnel.app

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:5000
