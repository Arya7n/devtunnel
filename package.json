{
  "name": "devtunnel",
  "version": "0.0.1",
  "private": true,
  "description": "A secure localhost tunneling platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check": "pnpm lint && pnpm typecheck",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "cli:build": "pnpm --filter @devtunnel/shared build && pnpm --filter @devtunnel/protocol build && pnpm --filter @devtunnel/cli build",
    "cli:link": "pnpm cli:build && npm --prefix apps/cli link",
    "cli:exe": "pnpm --filter @devtunnel/shared build && pnpm --filter @devtunnel/protocol build && pnpm --filter @devtunnel/cli build:exe"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pnpm": "^11.17.0"
  }
}
