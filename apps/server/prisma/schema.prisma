generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  apiKeys       ApiKey[]
  refreshTokens RefreshToken[]
  tunnels       Tunnel[]
  requestLogs   RequestLog[]
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyPrefix  String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Tunnel {
  id          String       @id
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subdomain   String
  localPort   Int
  status      String       @default("active") // active | closed
  createdAt   DateTime     @default(now())
  closedAt    DateTime?
  requestLogs RequestLog[]

  @@index([userId, status])
  @@index([subdomain])
  @@index([userId, createdAt])
}

model RequestLog {
  id         String   @id @default(cuid())
  requestId  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tunnelId   String?
  tunnel     Tunnel?  @relation(fields: [tunnelId], references: [id], onDelete: SetNull)
  subdomain  String
  method     String
  path       String
  status     Int
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([subdomain, createdAt])
  @@index([tunnelId, createdAt])
}
